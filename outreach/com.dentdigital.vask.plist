<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dentdigital.vask</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/umar/.dentdigital/outreach/vask-send.sh</string>
    <string>10</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>15</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <!-- Catch-up: run at boot/login too; vask-send.sh guards window/once-per-day -->
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/umar/.dentdigital/outreach/vask-cron.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/umar/.dentdigital/outreach/vask-cron.log</string>
</dict>
</plist>
